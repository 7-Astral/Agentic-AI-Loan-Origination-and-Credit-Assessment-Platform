# Postgres connection string used by the FastAPI backend (async driver).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/loan_origination

# API key for the Anthropic SDK. Only required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which LLM backend the agent uses: "ollama" (local, default) or "anthropic".
LLM_PROVIDER=ollama

# Ollama server the API container talks to. From inside Docker on Windows/Mac, the host's
# Ollama is reached via host.docker.internal; running the API outside Docker, use localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:latest

# Base URL the browser uses to reach the API through Docker's published port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Comma-separated list of origins allowed to call the API (CORS). Next.js falls back to
# 3001/3002 etc. when 3000 is already in use, so those are included by default too.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
