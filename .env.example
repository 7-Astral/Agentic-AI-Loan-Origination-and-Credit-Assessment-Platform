# Postgres connection string used by the FastAPI backend (async driver).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/loan_origination

# API key for the Anthropic SDK. Only required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which LLM backend the agent uses: "ollama" (local, default) or "anthropic".
LLM_PROVIDER=ollama

# Ollama server the API container talks to. From inside Docker on Windows/Mac, the host's
# Ollama is reached via host.docker.internal; running the API outside Docker, use localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:latest

# Mock credit bureau sandbox (services/mock-bureau). From inside Docker, the API reaches it
# by service name; running the API outside Docker, use http://localhost:8001 instead (its
# published port). Client credentials are dev-only defaults shared by both services — change
# both together if you change them. Swap mock_bureau_base_url for a real bureau's URL (and
# these credentials for real ones) to go live without changing any calling code.
MOCK_BUREAU_BASE_URL=http://mock-bureau:8000
MOCK_BUREAU_CLIENT_ID=demo-client-id
MOCK_BUREAU_CLIENT_SECRET=demo-client-secret

# ABN Lookup (Australian Business Register). Requires a free GUID registered with the ABR's
# web services (https://abr.business.gov.au/Tools/WebServices) — leave unset in dev and the
# ABN collector degrades to "unavailable" rather than failing.
ABR_GUID=

# Auth. "local" is a dev-stage substitute for the target Entra ID / Azure AD B2C
# architecture (see CLAUDE.md) — swap the provider, not calling code, when those land.
AUTH_PROVIDER=local
# Secret used to sign JWTs. Generate your own for any real deployment — e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"` — never reuse this value.
JWT_SECRET=change-this-to-a-random-secret-in-every-environment

# Base URL the browser uses to reach the API through Docker's published port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Comma-separated list of origins allowed to call the API (CORS). Next.js falls back to
# 3001/3002 etc. when 3000 is already in use, so those are included by default too.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
