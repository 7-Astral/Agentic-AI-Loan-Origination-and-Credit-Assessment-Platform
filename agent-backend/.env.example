# Copy to .env and fill in. docker-compose.yml overrides the URLs below with
# in-network service names, so these values are for running natively.

GEMINI_API_KEY=your-gemini-key

MODEL_INTERACTION=gemini-3.5-flash-lite
MODEL_DOCUMENT=gemini-3.7-flash
MODEL_ASSESSMENT=gemini-3.7-flash
MODEL_DECISION=gemini-3.7-flash

LANGGRAPH_DB_URL=postgresql://postgres:postgres@localhost:5433/loan_origination
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/loan_origination
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/loan_origination

# Assessment configuration (mock_core_banking)
CORE_BANKING_BASE_URL=http://127.0.0.1:9000
CORE_BANKING_API_KEY=mock-key

# Credit bureau stand-in (mock_bureau)
BUREAU_BASE_URL=http://127.0.0.1:9001
BUREAU_API_KEY=mock-bureau-key

# Product catalog (services/api). CATALOG_API_KEY must equal services/api's SERVICE_API_KEY.
CATALOG_BASE_URL=http://127.0.0.1:8000
CATALOG_API_KEY=dev-service-key-change-me
# Leave blank to resolve the bank by PLATFORM_BANK_CODE.
PLATFORM_BANK_ID=
PLATFORM_BANK_CODE=FNB001

# Must match services/api's JWT settings.
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256

APP_ENV=local
LOG_LEVEL=INFO
